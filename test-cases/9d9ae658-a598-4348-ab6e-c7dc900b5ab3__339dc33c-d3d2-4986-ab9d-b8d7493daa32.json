        "locatorHint": ".menu [data-testid=copy-campaign]"
      },
      {
        "id": "s11",
        "action": "assertVisible",
        "targetDescription": "Copy Campaign modal header visible",
        "screenName": "CampaignsPage",
        "pageObjectMethod": "expectCopyCampaignModalHeaderVisible"
