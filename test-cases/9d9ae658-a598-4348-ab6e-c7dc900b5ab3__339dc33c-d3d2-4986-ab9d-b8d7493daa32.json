    "preconditions": [],
    "steps": [
      {
        "id": "s1",
        "action": "openUrl",
        "targetDescription": "Open Login URL",
        "value": "https://app.propel.example/login"
      },
      {
        "id": "s2",
        "action": "fill",
        "targetDescription": "Login email",
        "screenName": "LoginPage",
        "pageObjectMethod": "fillEmail",
        "value": "user@advertiser.test"
      },
      {
        "id": "s3",
        "action": "fill",
        "targetDescription": "Login password",
        "screenName": "LoginPage",
        "pageObjectMethod": "fillPassword",
        "value": "Password123!"
      },
      {
        "id": "s4",
        "action": "tap",
        "targetDescription": "Click Log In",
        "screenName": "LoginPage",
        "pageObjectMethod": "clickLogIn"
      },
      {
        "id": "s5",
        "action": "assertVisible",
        "targetDescription": "Dashboard visible",
        "screenName": "DashboardPage",
        "pageObjectMethod": "expectDashboardVisible"
      },
      {
        "id": "s6",
        "action": "tap",
        "targetDescription": "Go to Campaigns",
        "screenName": "DashboardPage",
        "pageObjectMethod": "clickCampaigns"
      },
      {
        "id": "s7",
        "action": "assertVisible",
        "targetDescription": "Campaigns list visible",
        "screenName": "CampaignsPage",
        "pageObjectMethod": "expectCampaignsVisible"
      },
      {
        "id": "s8",
        "action": "assertContainsText",
