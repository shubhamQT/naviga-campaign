{
  "id": "34a94c1f-f1a8-4e28-9125-606a680f9375",
  "testPlanId": "9d9ae658-a598-4348-ab6e-c7dc900b5ab3",
  "requirementId": "a8409d58-5a57-41da-a2a7-434d9a5eb5f0",
  "suiteName": "[NSSP-2034] Copy Campaign with SLA Validation — Functional Happy Paths",
  "case": {
    "id": "34a94c1f-f1a8-4e28-9125-606a680f9375",
    "title": "Disabled product line is taken to resolution and removed; remaining valid lines preserved",
    "priority": "P1",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "s1",
        "action": "openUrl",
        "targetDescription": "Login",
        "value": "https://app.propel.example/login"
      },
      {
        "id": "s2",
        "action": "fill",
        "targetDescription": "Email",
        "screenName": "LoginPage",
        "pageObjectMethod": "fillEmail",
        "value": "user@advertiser.test"
      },
      {
        "id": "s3",
        "action": "fill",
        "targetDescription": "Password",
        "screenName": "LoginPage",
        "pageObjectMethod": "fillPassword",
        "value": "Password123!"
      },
      {
        "id": "s4",
        "action": "tap",
        "targetDescription": "Log In",
        "screenName": "LoginPage",
        "pageObjectMethod": "clickLogIn"
      },
      {
        "id": "s5",
        "action": "tap",
        "targetDescription": "Go to Campaigns",
        "screenName": "DashboardPage",
        "pageObjectMethod": "clickCampaigns"
      },
      {
        "id": "s6",
        "action": "assertContainsText",
        "targetDescription": "Confirm source 'Has Disabled Product'",
        "locatorHint": "#campaigns-table",
        "assertion": "Has Disabled Product"
      },
      {
        "id": "s7",
        "action": "tap",
        "targetDescription": "Open actions",
        "screenName": "CampaignsPage",
        "pageObjectMethod": "clickMuiTableRoot1TableButton"
      },
      {
        "id": "s8",
        "action": "tap",
        "targetDescription": "Copy Campaign",
        "locatorHint": ".menu [data-testid=copy-campaign]"
      },
      {
        "id": "s9",
        "action": "assertVisible",
        "targetDescription": "Resolution banner for disabled product shown",
        "locatorHint": "[data-testid=product-disabled-banner]"
      },
      {
        "id": "s10",
        "action": "tap",
        "targetDescription": "Confirm remove disabled line",
        "locatorHint": "[data-testid=remove-line]"
      },
      {
        "id": "s11",
        "action": "assertHidden",
        "targetDescription": "Disabled product line removed",
        "locatorHint": "[data-testid=line-disabled-product]"
      },
      {
        "id": "s12",
        "action": "assertContainsText",
        "targetDescription": "Valid line remains unchanged",
        "locatorHint": "[data-testid=line-1-details]",
        "assertion": "Homepage Banner"
      }
    ],
    "tags": [
      "@functional",
      "@regression"
    ]
  }
}
