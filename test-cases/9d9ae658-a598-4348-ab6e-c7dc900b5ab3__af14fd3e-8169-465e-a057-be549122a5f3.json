{
  "id": "af14fd3e-8169-465e-a057-be549122a5f3",
  "testPlanId": "9d9ae658-a598-4348-ab6e-c7dc900b5ab3",
  "requirementId": "a8409d58-5a57-41da-a2a7-434d9a5eb5f0",
  "suiteName": "[NSSP-2034] Copy Campaign with SLA Validation — Functional Happy Paths",
  "case": {
    "id": "af14fd3e-8169-465e-a057-be549122a5f3",
    "title": "Booking enabled only after revalidation passes; user sees clear resolution messaging when blocked and success messaging when enabled",
    "priority": "P1",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "s1",
        "action": "openUrl",
        "targetDescription": "Login",
        "value": "https://app.propel.example/login"
      },
      {
        "id": "s2",
        "action": "fill",
        "targetDescription": "Email",
        "screenName": "LoginPage",
        "pageObjectMethod": "fillEmail",
        "value": "user@advertiser.test"
      },
      {
        "id": "s3",
        "action": "fill",
        "targetDescription": "Password",
        "screenName": "LoginPage",
        "pageObjectMethod": "fillPassword",
        "value": "Password123!"
      },
      {
        "id": "s4",
        "action": "tap",
        "targetDescription": "Log In",
        "screenName": "LoginPage",
        "pageObjectMethod": "clickLogIn"
      },
      {
        "id": "s5",
        "action": "tap",
        "targetDescription": "Campaigns",
        "screenName": "DashboardPage",
        "pageObjectMethod": "clickCampaigns"
      },
      {
        "id": "s6",
        "action": "tap",
        "targetDescription": "Open actions for 'Has Disabled Rate'",
        "screenName": "CampaignsPage",
        "pageObjectMethod": "clickMuiTableRoot1TableButton"
      },
      {
        "id": "s7",
        "action": "tap",
        "targetDescription": "Copy Campaign",
        "locatorHint": ".menu [data-testid=copy-campaign]"
      },
      {
        "id": "s8",
        "action": "tap",
        "targetDescription": "Open Review & Payment",
        "locatorHint": "[data-testid=nav-review-payment]"
      },
      {
        "id": "s9",
        "action": "tap",
        "targetDescription": "Attempt to Confirm Payment",
        "screenName": "CampaignBookingPage",
        "pageObjectMethod": "clickConfirmPayment"
      },
      {
        "id": "s10",
        "action": "assertContainsText",
        "targetDescription": "Blocked message with corrective actions",
        "locatorHint": "[data-testid=booking-blocked-message]",
        "assertion": "Please resolve rate and schedule issues"
      },
      {
        "id": "s11",
        "action": "tap",
        "targetDescription": "Fix rate: Select replacement",
        "screenName": "ProductSelectionPage",
        "pageObjectMethod": "clickProductSelectionSelectRate"
      },
      {
        "id": "s12",
        "action": "tap",
        "targetDescription": "Pick Targeted CPM",
        "screenName": "ProductSelectionPage",
        "pageObjectMethod": "clickTargetedCpmRate"
      },
      {
        "id": "s13",
        "action": "tap",
        "targetDescription": "Fix schedule: Open calendar",
        "screenName": "BudgetAndSchedulePage",
        "pageObjectMethod": "clickCalendarViewIsOpen"
      },
      {
        "id": "s14",
        "action": "tap",
        "targetDescription": "Select valid date",
        "screenName": "BudgetAndSchedulePage",
        "pageObjectMethod": "clickMuiDayCalendarRoot1TableButton"
      },
      {
        "id": "s15",
        "action": "tap",
        "targetDescription": "Confirm date",
        "screenName": "BudgetAndSchedulePage",
        "pageObjectMethod": "clickOk"
      },
      {
        "id": "s16",
        "action": "tap",
        "targetDescription": "Re-open Review & Payment",
        "locatorHint": "[data-testid=nav-review-payment]"
      },
      {
        "id": "s17",
        "action": "assertHidden",
        "targetDescription": "Blocked message cleared",
        "locatorHint": "[data-testid=booking-blocked-message]"
      },
      {
        "id": "s18",
        "action": "assertEnabled",
        "targetDescription": "Confirm Payment now enabled",
        "locatorHint": "[data-testid=confirm-payment]"
      }
    ],
    "tags": [
      "@functional",
      "@regression"
    ]
  }
}
