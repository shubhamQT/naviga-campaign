  "case": {
    "id": "3c7aa8d9-c551-4239-a2f6-8179cd9988f7",
    "title": "Audit logging captures changes during resolution (status, product, rate, schedule) with timestamp",
    "priority": "P2",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "s1",
        "action": "openUrl",
        "targetDescription": "Login",
        "value": "https://app.propel.example/login"
      },
      {
        "id": "s2",
        "action": "fill",
        "targetDescription": "Email",
        "screenName": "LoginPage",
        "pageObjectMethod": "fillEmail",
        "value": "admin@publisher.test"
      },
      {
        "id": "s3",
        "action": "fill",
        "targetDescription": "Password",
        "screenName": "LoginPage",
        "pageObjectMethod": "fillPassword",
        "value": "Password123!"
      },
      {
        "id": "s4",
        "action": "tap",
        "targetDescription": "Log In",
        "screenName": "LoginPage",
        "pageObjectMethod": "clickLogIn"
      },
      {
        "id": "s5",
        "action": "tap",
        "targetDescription": "Campaigns",
        "screenName": "DashboardPage",
        "pageObjectMethod": "clickCampaigns"
      },
      {
        "id": "s6",
        "action": "tap",
        "targetDescription": "Open actions and copy a campaign with issues",
        "screenName": "CampaignsPage",
        "pageObjectMethod": "clickMuiTableRoot1TableButton"
      },
      {
        "id": "s7",
        "action": "tap",
        "targetDescription": "Copy Campaign",
        "locatorHint": ".menu [data-testid=copy-campaign]"
      },
      {
        "id": "s8",
        "action": "tap",
        "targetDescription": "Replace disabled rate",
        "screenName": "ProductSelectionPage",
        "pageObjectMethod": "clickProductSelectionSelectRate"
      },
      {
        "id": "s9",
        "action": "tap",
        "targetDescription": "Pick Targeted CPM rate",
        "screenName": "ProductSelectionPage",
        "pageObjectMethod": "clickTargetedCpmRate"
      },
      {
        "id": "s10",
        "action": "tap",
        "targetDescription": "Open schedule editor",
        "screenName": "BudgetAndSchedulePage",
        "pageObjectMethod": "clickCalendarViewIsOpen"
      },
      {
        "id": "s11",
        "action": "tap",
        "targetDescription": "Select a new date",
        "screenName": "BudgetAndSchedulePage",
        "pageObjectMethod": "clickMuiDayCalendarRoot1TableButton"
      },
      {
        "id": "s12",
        "action": "tap",
        "targetDescription": "Confirm date",
        "screenName": "BudgetAndSchedulePage",
        "pageObjectMethod": "clickOk"
      },
      {
        "id": "s13",
        "action": "tap",
        "targetDescription": "Open Audit Log tab/panel",
        "locatorHint": "[data-testid=audit-log-tab]"
      },
      {
        "id": "s14",
        "action": "assertVisible",
        "targetDescription": "Audit log row for rate change",
        "locatorHint": "[data-testid=audit-log-row][data-action='RateChanged']"
      },
      {
        "id": "s15",
        "action": "assertVisible",
        "targetDescription": "Audit log row for schedule change",
        "locatorHint": "[data-testid=audit-log-row][data-action='ScheduleUpdated']"
      },
      {
        "id": "s16",
        "action": "assertContainsText",
        "targetDescription": "Audit log entry contains timestamp",
        "locatorHint": "[data-testid=audit-log-row]:first-child [data-testid=timestamp]",
        "assertion": ":"
      }
    ],
    "tags": [
      "@functional",
      "@regression"
    ]
  }
