      {
        "id": "s7",
        "action": "tap",
        "targetDescription": "Copy Campaign",
        "locatorHint": ".menu [data-testid=copy-campaign]"
      },
      {
        "id": "s8",
        "action": "tap",
        "targetDescription": "Copy Now",
        "screenName": "CampaignsPage",
        "pageObjectMethod": "clickCopyNow"
      },
      {
        "id": "s9",
        "action": "assertHidden",
        "targetDescription": "Spinner hidden",
        "screenName": "CampaignsPage",
        "pageObjectMethod": "expectLoadingImageHidden"
      },
      {
        "id": "s10",
        "action": "tap",
        "targetDescription": "Open Billing Information step",
        "locatorHint": "[data-testid=nav-billing]"
      },
      {
        "id": "s11",
        "action": "assertVisible",
        "targetDescription": "Billing Information page visible",
        "screenName": "BillingInformationPage",
        "pageObjectMethod": "expectBillingInformationVisible"
      },
      {
        "id": "s12",
        "action": "assertValue",
