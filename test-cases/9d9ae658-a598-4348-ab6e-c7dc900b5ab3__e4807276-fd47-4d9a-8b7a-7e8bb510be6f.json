{
  "id": "e4807276-fd47-4d9a-8b7a-7e8bb510be6f",
  "testPlanId": "9d9ae658-a598-4348-ab6e-c7dc900b5ab3",
  "requirementId": "a8409d58-5a57-41da-a2a7-434d9a5eb5f0",
  "suiteName": "[NSSP-2034] Copy Campaign with SLA Validation — Functional Happy Paths",
  "case": {
    "id": "e4807276-fd47-4d9a-8b7a-7e8bb510be6f",
    "title": "Copied campaign has lifecycle statuses reset to initial Draft and follows standard approval workflow (no bypass)",
    "priority": "P1",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "s1",
        "action": "openUrl",
        "targetDescription": "Open Login",
        "value": "https://app.propel.example/login"
      },
      {
        "id": "s2",
        "action": "fill",
        "targetDescription": "Email",
        "screenName": "LoginPage",
        "pageObjectMethod": "fillEmail",
        "value": "admin@publisher.test"
      },
      {
        "id": "s3",
        "action": "fill",
        "targetDescription": "Password",
        "screenName": "LoginPage",
        "pageObjectMethod": "fillPassword",
        "value": "Password123!"
      },
      {
        "id": "s4",
        "action": "tap",
        "targetDescription": "Log In",
        "screenName": "LoginPage",
        "pageObjectMethod": "clickLogIn"
      },
      {
        "id": "s5",
        "action": "tap",
        "targetDescription": "Go to Campaigns",
        "screenName": "DashboardPage",
        "pageObjectMethod": "clickCampaigns"
      },
      {
        "id": "s6",
        "action": "tap",
        "targetDescription": "Open actions for a campaign",
        "screenName": "CampaignsPage",
        "pageObjectMethod": "clickMuiTableRoot1TableButton"
      },
      {
        "id": "s7",
        "action": "tap",
        "targetDescription": "Copy Campaign",
        "locatorHint": ".menu [data-testid=copy-campaign]"
      },
      {
        "id": "s8",
        "action": "tap",
        "targetDescription": "Copy Now",
        "screenName": "CampaignsPage",
        "pageObjectMethod": "clickCopyNow"
      },
      {
        "id": "s9",
        "action": "assertHidden",
        "targetDescription": "Copy spinner hidden",
        "screenName": "CampaignsPage",
        "pageObjectMethod": "expectLoadingImageHidden"
      },
      {
        "id": "s10",
        "action": "assertVisible",
        "targetDescription": "Basic Information visible",
        "screenName": "BasicInformationPage",
        "pageObjectMethod": "expectBasicInformationVisible"
      },
      {
        "id": "s11",
        "action": "assertContainsText",
        "targetDescription": "Status badge shows Draft",
        "locatorHint": "[data-testid=status-badge]",
        "assertion": "Draft"
      },
      {
        "id": "s12",
        "action": "assertHidden",
        "targetDescription": "Cannot bypass approval - no Approved status yet",
        "locatorHint": "[data-testid=status-badge][data-status='Approved']"
      }
    ],
    "tags": [
      "@functional",
      "@regression"
    ]
  }
}
